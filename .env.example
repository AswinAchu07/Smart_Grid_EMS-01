# ==============================================================================
# Environment Configuration for Smart Grid Solar PV & Battery EMS
# ==============================================================================

# Project Details
PROJECT_NAME="ML-Based Solar PV & Battery EMS"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security & JWT Auth
# In production, generate a secure random key using `openssl rand -hex 32`
SECRET_KEY="smart-grid-ems-super-secure-production-secret-key-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Uses SQLite locally by default for zero-setup ease, or PostgreSQL URL in production
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/smart_grid_ems
DATABASE_URL="sqlite:///./smart_grid_ems.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:8501"

# Default System Admin Credentials (seeded on first run)
DEFAULT_ADMIN_EMAIL="admin@smartgrid.local"
DEFAULT_ADMIN_PASSWORD="AdminSecurePassword123!"

# Battery Default Settings
DEFAULT_BATTERY_CAPACITY_KWH=10.0
DEFAULT_BATTERY_MIN_SOC=0.15
DEFAULT_BATTERY_MAX_SOC=0.95
DEFAULT_BATTERY_MAX_CHARGE_KW=5.0
DEFAULT_BATTERY_MAX_DISCHARGE_KW=5.0
DEFAULT_BATTERY_CHARGE_EFF=0.95
DEFAULT_BATTERY_DISCHARGE_EFF=0.95

# Electricity Tariffs ($/kWh)
DEFAULT_PEAK_PRICE=0.35
DEFAULT_OFFPEAK_PRICE=0.10
DEFAULT_STANDARD_PRICE=0.18
DEFAULT_FEED_IN_TARIFF=0.08
DEFAULT_DEGRADATION_COST=0.01
